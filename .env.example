# Variables à définir dans Vercel (Settings → Environment Variables).
# DATABASE_URL est ajoutée automatiquement quand on relie une base Neon au projet.
DATABASE_URL=postgresql://...-pooler.../neondb?sslmode=require
# Connexion directe (migrations, pg_dump) — écrite aussi par `neon deploy` / `neon env pull`
DATABASE_URL_UNPOOLED=postgresql://.../neondb?sslmode=require
# Mot de passe pour ouvrir l'agenda (choisissez le vôtre)
APP_PASSWORD=
# Clé API Claude (console.anthropic.com → API Keys). Sans elle, l'assistant simple intégré est utilisé.
ANTHROPIC_API_KEY=
