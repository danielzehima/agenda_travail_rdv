# Variables à définir dans Vercel (Settings → Environment Variables).
# DATABASE_URL est ajoutée automatiquement quand on relie une base Neon au projet.
DATABASE_URL=postgresql://utilisateur:motdepasse@xxxx.neon.tech/neondb?sslmode=require
# Mot de passe pour ouvrir l'agenda (choisissez le vôtre)
APP_PASSWORD=
